{
  "name": "@dylanmtaylor/backstage-plugin-kargo",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "./alpha": {
        "backstage": "@backstage/FrontendPlugin",
        "types": "./dist/alpha.d.ts",
        "default": "./dist/alpha.esm.js"
      },
      "./package.json": "./package.json",
      "./testUtils": {
        "types": "./dist/testUtils.d.ts",
        "default": "./dist/testUtils.esm.js"
      }
    },
    "typesVersions": {
      "*": {
        "alpha": [
          "dist/alpha.d.ts"
        ],
        "package.json": [
          "package.json"
        ],
        "testUtils": [
          "dist/testUtils.d.ts"
        ]
      }
    }
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "kargo"
  },
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.10.1",
    "@backstage/core-compat-api": "^0.5.15",
    "@backstage/core-components": "^0.18.14",
    "@backstage/core-plugin-api": "^1.12.10",
    "@backstage/errors": "^1.3.1",
    "@backstage/frontend-plugin-api": "^0.18.1",
    "@backstage/plugin-catalog-react": "^3.2.3",
    "@dylanmtaylor/backstage-plugin-kargo-common": "workspace:^",
    "@material-ui/core": "^4.12.4",
    "luxon": "^3.7.2",
    "react-use": "^17.2.4"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "6.0.0-beta.0 || ^6.3.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/dev-utils": "^1.1.27",
    "@backstage/frontend-test-utils": "^0.6.4",
    "@backstage/plugin-catalog": "^2.0.9",
    "@backstage/test-utils": "^1.7.22",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/luxon": "^3.7.1",
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "files": [
    "dist"
  ],
  "description": "A Backstage frontend plugin that shows Kargo Stages, Promotions, Freight, and Warehouses on entity pages",
  "homepage": "https://github.com/dylanmtaylor/backstage-plugin-kargo",
  "repository": {
    "type": "git",
    "url": "https://github.com/dylanmtaylor/backstage-plugin-kargo",
    "directory": "plugins/kargo"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "kargo",
    "gitops",
    "argo"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha.tsx",
    "./package.json": "./package.json",
    "./testUtils": "./src/testUtils/index.ts"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha.tsx"
      ],
      "package.json": [
        "package.json"
      ],
      "testUtils": [
        "src/testUtils/index.ts"
      ]
    }
  }
}
